GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
API_PORT=8787
API_HOST=127.0.0.1
# Exact frontend origins, separated by commas. Add the deployed frontend origin here.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# The root .env VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY values are also supported.
SUPABASE_URL=
SUPABASE_ANON_KEY=
API_RATE_LIMIT=10
API_MAX_CONCURRENT=4
API_PROVIDER_TIMEOUT_MS=30000
API_AUTH_TIMEOUT_MS=8000
